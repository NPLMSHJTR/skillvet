# Normalize line endings: LF in the repository, LF on checkout everywhere.
# This matters because CI runs on Linux and the code is developed on Windows;
# mixed endings break shebangs, diff noise, and snapshot comparisons.
* text=auto eol=lf

# Shell scripts must keep LF to stay executable.
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.whl binary
*.gz binary